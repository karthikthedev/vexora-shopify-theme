            {%- endif -%}
          </div>
        </div>

        {%- comment -%} Column 2 — Quick Links {%- endcomment -%}
        <div class="vxft-col">
          <h4 class="vxft-col-title">Quick Links</h4>
          <ul class="vxft-links" role="list">
            <li><a href="/pages/about-us">About Us</a></li>
            <li><a href="/collections/fitness">All Products</a></li>
            <li><a href="/collections/posture-corrector">Posture Correctors</a></li>
            <li><a href="/collections/smart-posture-tech">Smart Posture Tech</a></li>
            <li><a href="/collections/back-pain-relief">Back Pain Relief</a></li>
            
          </ul>
        </div>

        {%- comment -%} Column 3 — Policies {%- endcomment -%}
        <div class="vxft-col">
          <h4 class="vxft-col-title">Policies</h4>
          <ul class="vxft-links" role="list">
            <li><a href="/pages/privacy-policy">Privacy Policy</a></li>
            <li><a href="/pages/refund-return">Refund &amp; Returns</a></li>
            <li><a href="/pages/terms-of-service">Terms of Service</a></li>
            
            <li><a href="/pages/contact-us">Contact Us</a></li>
            
          </ul>
        </div>

        {%- comment -%} Column 4 — Newsletter + Contact {%- endcomment -%}
        <div class="vxft-col vxft-col--newsletter">
          <h4 class="vxft-col-title">Stay in the loop</h4>
          <p class="vxft-nl-desc">Wellness tips, new launches, and member-only offers — straight to your inbox.</p>

          <form class="vxft-nl-form" action="/contact#contact_form" method="post" id="vxft-nl-form" novalidate>
            <input type="hidden" name="form_type" value="customer">
            <input type="hidden" name="utf8" value="✓">
            <div class="vxft-nl-row">
              <input
                type="email"
                name="contact[email]"
                class="vxft-nl-input"
                placeholder="your@email.com"
                aria-label="Email address"
                required
                autocomplete="email"
              >
              <button type="submit" class="vxft-nl-btn" aria-label="Subscribe">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M2 8h12M10 4l4 4-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>
            <p class="vxft-nl-fine">No spam, ever. Unsubscribe anytime.</p>
          </form>

          <div class="vxft-contact-row">
            <a href="mailto:{{ section.settings.contact_email | default: 'contact@example.com' }}" class="vxft-contact-link" aria-label="Email us">
              <svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
                <rect x="1" y="3" width="13" height="9" rx="1.5" stroke="currentColor" stroke-width="1.3"/>
                <path d="M1 4.5l6.5 4 6.5-4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
              </svg>
              {{ section.settings.contact_email  }}
            </a>
          </div>
        </div>

      </div>
    </div>

