<style>
/* ── Tokens ──────────────────────────────────────────────────── */
.vxft {
  --bg:      #FFF3E4;
  --dark:    #0E1117;
  --dark-2:  #161B24;
  --pri:     #F97316;
  --sec:     #FB923C;
  --white:   #FFFFFF;
  --ink:     #111827;
  --muted:   rgba(255,255,255,0.50);
  --border:  rgba(255,255,255,0.07);
  --f-disp:  'Playfair Display', Georgia, serif;
  --f-body:  'Jost', system-ui, sans-serif;
  --ease:    cubic-bezier(.22,1,.36,1);
}

/* ── Wave connector ─────────────────────────────────────────── */
.vxft-wave {
  display: block;
  line-height: 0;
  background: var(--bg);
  margin-bottom: -2px;
}
.vxft-wave svg { display: block; width: 100%; }

/* ── Body ───────────────────────────────────────────────────── */
.vxft-body {
  background: var(--dark);
  position: relative;
  overflow: hidden;
  font-family: var(--f-body);
}

/* Dot texture */
.vxft-body::before {
  content: '';
  position: absolute; inset: 0;
  background-image: radial-gradient(rgba(249,115,22,0.07) 1px, transparent 1px);
  background-size: 30px 30px;
  pointer-events: none; z-index: 0;
}

/* Ambient glow */
.vxft-body::after {
  content: '';
  position: absolute; top: -80px; left: 50%;
  transform: translateX(-50%);
  width: 700px; height: 300px;
  background: radial-gradient(ellipse at 50% 0%, rgba(249,115,22,0.10) 0%, transparent 65%);
  pointer-events: none; z-index: 0;
}

/* ── Container ──────────────────────────────────────────────── */
.vxft-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 48px;
  position: relative; z-index: 2;
}

/* ── Main grid ──────────────────────────────────────────────── */
.vxft-grid {
  display: grid;
  grid-template-columns: 1.4fr 1fr 1fr 1.4fr;
  gap: 48px;
  padding: 72px 0 56px;
  border-bottom: 1px solid var(--border);
}

/* ── Column base ────────────────────────────────────────────── */
.vxft-col {}
.vxft-col-title {
  font-family: var(--f-body);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--pri);
  margin: 0 0 20px;
}

/* ── Brand column ───────────────────────────────────────────── */
.vxft-logo { display: inline-block; text-decoration: none; margin-bottom: 18px; }
.vxft-logo-img { height: 40px; width: auto; display: block; }
.vxft-wordmark {
  font-family: var(--f-disp);
  font-size: 1.8rem;
  font-weight: 700;
  color: var(--white);
  letter-spacing: -0.02em;
  line-height: 1;
}
.vxft-wordmark span { color: var(--pri); }

.vxft-tagline {
  font-size: 13.5px;
  line-height: 1.70;
  color: var(--muted);
  font-weight: 300;
  margin: 0 0 22px;
  max-width: 280px;
}

/* Trust mini-badges */
.vxft-trust-row {
  display: flex;
  flex-direction: column;
  gap: 9px;
  margin-bottom: 24px;
}
.vxft-trust-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  font-weight: 500;
  color: rgba(255,255,255,0.65);
  letter-spacing: 0.02em;
}

/* Social icons */
.vxft-socials {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}
.vxft-social {
  width: 38px; height: 38px;
  border-radius: 10px;
  background: rgba(255,255,255,0.06);
  border: 1px solid var(--border);
  display: flex; align-items: center; justify-content: center;
  color: rgba(255,255,255,0.55);
