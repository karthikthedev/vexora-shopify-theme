{% comment %}
  ╔══════════════════════════════════════════════════════════════════╗
  ║  VEXORACARE — Footer Section                                      ║
  ║  File: sections/vexoracare-footer.liquid                          ║
  ║  Add via: Theme Editor → Footer group → Add section               ║
  ╚══════════════════════════════════════════════════════════════════╝
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">

<footer class="vxft" role="contentinfo" aria-label="Site footer">

  {%- comment -%} ── Top wave transition from page bg ── {%- endcomment -%}
  <div class="vxft-wave" aria-hidden="true">
    <svg viewBox="0 0 1440 72" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0,36 C360,72 720,0 1080,48 C1260,72 1380,24 1440,12 L1440,72 L0,72 Z" fill="#0E1117"/>
    </svg>
  </div>

  <div class="vxft-body">

    {%- comment -%} ── MAIN GRID ── {%- endcomment -%}
    <div class="vxft-container">
      <div class="vxft-grid">

        {%- comment -%} Column 1 — Brand {%- endcomment -%}
        <div class="vxft-col vxft-col--brand">
          <a href="{{ routes.root_url }}" class="vxft-logo" aria-label="VexoraCare home">
            {%- if section.settings.logo != blank -%}
              <img src="{{ section.settings.logo | img_url: '280x' }}" alt="{{ shop.name }}" class="vxft-logo-img" loading="lazy" width="140" height="40">
            {%- else -%}
              <span class="vxft-wordmark">Vexora<span>care</span></span>
            {%- endif -%}
          </a>
          <p class="vxft-tagline">{{ section.settings.tagline | default: 'Wellness without compromise. Clinically inspired products for the way your body actually moves.' }}</p>

          {%- comment -%} Trust mini-badges ── {%- endcomment -%}
          <div class="vxft-trust-row">
            <div class="vxft-trust-badge">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M7 1l1.3 3.7h3.9l-3.2 2.3.8 3.9L7 9l-2.8 1.9.8-3.9L1.8 4.7h3.9z" stroke="#F97316" stroke-width="1.2" fill="none"/></svg>
              Physio Approved
            </div>
            
          </div>

          {%- comment -%} Social icons {%- endcomment -%}
          <div class="vxft-socials">
            <a
              href="{{ section.settings.instagram_url | default: 'https://www.instagram.com/vexoracare?igsh=ZWg1ZXk1bzcwcmE%3D' }}"
              target="_blank" rel="noopener noreferrer"
              class="vxft-social" aria-label="Follow VexoraCare on Instagram"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 2 .3 2.5.6.6.3 1 .6 1.5 1.1.4.4.8.9 1.1 1.5.3.5.5 1.3.6 2.5.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.3 2-.6 2.5-.3.6-.6 1-1.1 1.5-.4.4-.9.8-1.5 1.1-.5.3-1.3.5-2.5.6-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-2-.3-2.5-.6-.6-.3-1-.6-1.5-1.1-.4-.4-.8-.9-1.1-1.5-.3-.5-.5-1.3-.6-2.5C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c.1-1.2.3-2 .6-2.5.3-.6.6-1 1.1-1.5.4-.4.9-.8 1.5-1.1.5-.3 1.3-.5 2.5-.6C8.4 2.2 8.8 2.2 12 2.2zm0 1.8c-3.1 0-3.5 0-4.8.1-1 .1-1.6.2-2 .4-.5.2-.8.4-1.1.7-.3.3-.5.6-.7 1.1-.2.4-.3 1-.4 2-.1 1.3-.1 1.7-.1 4.8s0 3.5.1 4.8c.1 1 .2 1.6.4 2 .2.5.4.8.7 1.1.3.3.6.5 1.1.7.4.2 1 .3 2 .4 1.3.1 1.7.1 4.8.1s3.5 0 4.8-.1c1-.1 1.6-.2 2-.4.5-.2.8-.4 1.1-.7.3-.3.5-.6.7-1.1.2-.4.3-1 .4-2 .1-1.3.1-1.7.1-4.8s0-3.5-.1-4.8c-.1-1-.2-1.6-.4-2-.2-.5-.4-.8-.7-1.1-.3-.3-.6-.5-1.1-.7-.4-.2-1-.3-2-.4-1.3-.1-1.7-.1-4.8-.1zM12 5.8a6.2 6.2 0 1 1 0 12.4A6.2 6.2 0 0 1 12 5.8zm0 10.2a4 4 0 1 0 0-8.1 4 4 0 0 0 0 8.1zm6.3-11.8a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3z"/>
              </svg>
            </a>
            <a
              href="{{ section.settings.tiktok_url | default: 'https://www.tiktok.com' }}"
              target="_blank" rel="noopener noreferrer"
              class="vxft-social" aria-label="Follow VexoraCare on TikTok"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12.5 2c1.1 0 2.1.1 3 .4 0 1.5.4 2.9 1.1 4.1.8 1.3 1.9 2.2 3.4 2.8v3.2a8.8 8.8 0 0 1-4.6-1.4v6.8a6.8 6.8 0 1 1-6.8-6.8c.3 0 .6 0 .9.1v3.2a3.5 3.5 0 1 0 2.6 3.3V2z"/>
              </svg>
            </a>
            {%- if section.settings.facebook_url != blank -%}
