                  <path d="M24 12a12 12 0 1 0-13.9 11.9v-8.4H7.1V12h3v-2.6c0-2.9 1.8-4.6 4.4-4.6 1.3 0 2.6.2 2.6.2v2.9H15.6c-1.4 0-1.9.9-1.9 1.8V12h3.2l-.5 3.5H13.7v8.4A12 12 0 0 0 24 12z"/>
                </svg>
