{% comment %}
  ============================================================
  FULL CART PAGE  —  Poppins + Light Orange
  Drop this in as: sections/main-cart.liquid
  (If you paste it into templates/cart.liquid instead,
   delete the {% schema %} block at the very bottom.)
  ============================================================
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

{%- liquid
  assign threshold = section.settings.free_shipping_threshold | times: 10
  assign progress = 0
  if threshold > 0
    assign progress = cart.total_price | times: 10.0 | divided_by: threshold | round
    if progress > 10
      assign progress = 10
    endif
  endif
  assign remaining = threshold | minus: cart.total_price
  assign continue_url = section.settings.continue_url
  if continue_url == blank
    assign continue_url = routes.all_products_collection_url
  endif
-%}

<style>
  #shopify-section-{{ section.id }} {
    --brand:        {{ section.settings.color_accent }};
    --brand-dark:   {{ section.settings.color_accent_dark }};
    --brand-050:    {{ section.settings.color_soft }};
    --brand-100:    #FFEBD2;
    --brand-200:    #FFD9A8;
    --ink:          #16130F;
    --ink-2:        #4A443D;
    --muted:        #857D74;
    --line:         #EFE6DA;
    --line-2:       #F6F1EA;
    --surface:      #FFFFFF;
    --canvas:       #FDFBF8;
    --danger:       #C4372B;
    --success:      #1F8A5B;
    --r-lg:         16px;
    --r-md:         12px;
    --r-sm:         10px;
    --shadow-sm:    0 1px 2px rgba(24,18,10,.05), 0 1px 8px rgba(24,18,10,.04);
    --shadow-md:    0 6px 24px rgba(24,18,10,.07);
    --shadow-brand: 0 8px 24px rgba(255,159,69,.28);
    --ease:         cubic-bezier(.4,0,.2,1);
  }

  .cartx {
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    color: var(--ink);
    background: var(--canvas);
    -webkit-font-smoothing: antialiased;
    line-height: 1.55;
  }
  .cartx *, .cartx *::before, .cartx *::after { box-sizing: border-box; }
  .cartx button, .cartx input, .cartx textarea, .cartx select { font: inherit; color: inherit; }
  .cartx a { color: inherit; text-decoration: none; }
  .cartx img { display: block; max-width: 100%; }

  .cartx__inner { max-width: 1280px; margin: 0 auto; padding: 48px 24px 80px; }

  /* ---------- Header ---------- */
  .cartx__head { margin-bottom: 28px; }
  .cartx__eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: .75rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase;
    color: var(--brand-dark); background: var(--brand-050);
    border: 1px solid var(--brand-100);
    padding: 6px 12px; border-radius: 999px; margin-bottom: 16px;
  }
  .cartx__title {
    font-size: clamp(2rem, 4vw, 2.9rem); font-weight: 600; letter-spacing: -.02em;
    line-height: 1.1; margin: 0 0 8px;
  }
  .cartx__sub { font-size: .975rem; color: var(--muted); margin: 0; font-weight: 300; }

  /* ---------- Free shipping meter ---------- */
  .ship {
    background: linear-gradient(135deg, var(--brand-050) 0%, #FFFDFA 100%);
    border: 1px solid var(--brand-100);
    border-radius: var(--r-lg);
    padding: 18px 22px;
    margin: 24px 0 32px;
    box-shadow: var(--shadow-sm);
  }
  .ship__row { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
  .ship__icon { flex: none; color: var(--brand-dark); }
  .ship__text { font-size: .925rem; font-weight: 400; color: var(--ink-2); margin: 0; }
  .ship__text b { font-weight: 600; color: var(--ink); }
  .ship__bar { height: 8px; border-radius: 999px; background: #FFFFFF; border: 1px solid var(--brand-100); overflow: hidden; }
  .ship__fill {
    height: 100%; border-radius: 999px;
    background: linear-gradient(90deg, var(--brand-200), var(--brand) 60%, var(--brand-dark));
    transition: width .6s var(--ease);
  }
  .ship--done .ship__text { color: var(--success); font-weight: 500; }

  /* ---------- Layout ---------- */
  .cartx__grid { display: grid; grid-template-columns: minmax(0,1fr) 380px; gap: 28px; align-items: start; }

  /* ---------- Items panel ---------- */
  .panel {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }
  .panel__head {
    display: grid;
    grid-template-columns: 96px minmax(0,1fr) 132px 104px 120px;
    gap: 18px; align-items: center;
    padding: 16px 24px;
    background: var(--line-2);
    border-bottom: 1px solid var(--line);
    font-size: .72rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--muted);
  }
  .panel__head span:nth-child(3) { text-align: center; }
  .panel__head span:nth-child(4),
  .panel__head span:nth-child(5) { text-align: right; }

  .ci {
    display: grid;
    grid-template-columns: 96px minmax(0,1fr) 132px 104px 120px;
    gap: 18px; align-items: center;
    padding: 22px 24px;
    border-bottom: 1px solid var(--line-2);
    transition: background .2s var(--ease);
  }
  .ci:last-of-type { border-bottom: 0; }
  .ci:hover { background: #FFFCF8; }

  .ci__media {
    width: 96px; height: 96px; border-radius: var(--r-md); overflow: hidden;
    border: 1px solid var(--line); background: var(--line-2); flex: none;
  }
  .ci__media img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s var(--ease); }
  .ci:hover .ci__media img { transform: scale(1.06); }
  .ci__ph { width: 100%; height: 100%; display: grid; place-items: center; color: #CFC6BA; }

  .ci__info { min-width: 0; display: flex; flex-direction: column; gap: 6px; }
  .ci__name { font-size: .975rem; font-weight: 500; letter-spacing: -.01em; transition: color .2s var(--ease); }
  .ci__name:hover { color: var(--brand-dark); }
  .ci__meta { display: flex; flex-wrap: wrap; gap: 6px; }
  .ci__chip {
    font-size: .74rem; font-weight: 400; color: var(--ink-2);
    background: var(--line-2); border: 1px solid var(--line);
    padding: 3px 9px; border-radius: 999px;
  }
  .ci__discount {
    display: inline-flex; align-items: center; gap: 5px; width: fit-content;
    font-size: .74rem; font-weight: 500; color: var(--success);
    background: #EAF7F0; border: 1px solid #CFEBDD;
    padding: 3px 9px; border-radius: 999px;
  }
  .ci__unit-m { display: none; font-size: .85rem; color: var(--muted); }

  /* Stepper */
  .qty {
    display: inline-grid; grid-template-columns: 34px 1fr 34px; align-items: center;
    border: 1px solid var(--line); border-radius: 999px; background: var(--surface);
    overflow: hidden; margin: 0 auto; width: 118px;
    transition: border-color .2s var(--ease), box-shadow .2s var(--ease);
  }
  .qty:focus-within { border-color: var(--brand); box-shadow: 0 0 0 3px rgba(255,159,69,.18); }
  .qty__btn {
    height: 38px; border: 0; background: transparent; cursor: pointer;
    font-size: 1.05rem; font-weight: 500; color: var(--ink-2); line-height: 1;
    display: grid; place-items: center; transition: background .18s var(--ease), color .18s var(--ease);
  }
  .qty__btn:hover:not(:disabled) { background: var(--brand-050); color: var(--brand-dark); }
  .qty__btn:disabled { opacity: .35; cursor: not-allowed; }
  .qty__input {
    height: 38px; width: 100%; border: 0; text-align: center; background: transparent;
    font-size: .925rem; font-weight: 500; -moz-appearance: textfield;
  }
  .qty__input::-webkit-outer-spin-button,
  .qty__input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .qty__input:focus { outline: none; }

  .ci__price { text-align: right; font-size: .925rem; font-weight: 400; color: var(--ink-2); }
  .ci__total { text-align: right; display: flex; flex-direction: column; align-items: flex-end; gap: 6px; }
  .ci__total-now { font-size: 1.02rem; font-weight: 600; letter-spacing: -.01em; }
  .ci__total-was { font-size: .8rem; color: var(--muted); text-decoration: line-through; }
  .ci__remove {
    display: inline-flex; align-items: center; gap: 5px;
    background: none; border: 0; padding: 2px 0; cursor: pointer;
    font-size: .78rem; font-weight: 400; color: var(--muted);
    transition: color .2s var(--ease);
  }
  .ci__remove:hover { color: var(--danger); }

  /* Note */
  .note { padding: 20px 24px; border-top: 1px solid var(--line); background: #FFFDFA; }
  .note__label { display: block; font-size: .8rem; font-weight: 500; color: var(--ink-2); margin-bottom: 8px; }
  .note textarea {
    width: 100%; min-height: 82px; resize: vertical;
    border: 1px solid var(--line); border-radius: var(--r-sm);
    padding: 12px 14px; font-size: .9rem; background: var(--surface);
    transition: border-color .2s var(--ease), box-shadow .2s var(--ease);
  }
  .note textarea:focus { outline: none; border-color: var(--brand); box-shadow: 0 0 0 3px rgba(255,159,69,.16); }

  /* ---------- Summary ---------- */
  .sum {
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg);
    box-shadow: var(--shadow-md); position: sticky; top: 20px; overflow: hidden;
  }
  .sum__head { padding: 22px 24px 16px; border-bottom: 1px dashed var(--line); }
  .sum__title { margin: 0; font-size: 1.05rem; font-weight: 600; letter-spacing: -.01em; }
  .sum__body { padding: 8px 24px 4px; margin: 0; }
  .sum__row { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 11px 0; font-size: .925rem; }
  .sum__row dt { color: var(--muted); font-weight: 300; margin: 0; }
  .sum__row dd { margin: 0; font-weight: 500; }
  .sum__row--muted dd { color: var(--muted); font-weight: 400; font-size: .85rem; }
  .sum__row--save dt, .sum__row--save dd { color: var(--success); font-weight: 500; }
  .sum__total {
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
    margin: 8px 24px 0; padding: 18px 0 20px; border-top: 1px solid var(--line);
  }
  .sum__total-l { font-size: 1rem; font-weight: 600; }
  .sum__total-l small { display: block; font-size: .72rem; font-weight: 300; color: var(--muted); letter-spacing: .02em; }
  .sum__total-v { font-size: 1.55rem; font-weight: 600; letter-spacing: -.02em; color: var(--brand-dark); }

  .sum__actions { padding: 0 24px 22px; }
  .btn-checkout {
    position: relative; overflow: hidden;
    width: 100%; border: 0; cursor: pointer;
    padding: 16px 22px; border-radius: var(--r-md);
    background: linear-gradient(135deg, var(--brand) 0%, var(--brand-dark) 100%);
    color: #fff; font-size: 1rem; font-weight: 600; letter-spacing: .01em;
    box-shadow: var(--shadow-brand);
    transition: transform .2s var(--ease), box-shadow .2s var(--ease);
    display: flex; align-items: center; justify-content: center; gap: 9px;
  }
  .btn-checkout::after {
    content: ''; position: absolute; top: 0; bottom: 0; left: -60%; width: 45%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,.35), transparent);
    transform: skewX(-20deg); transition: left .6s var(--ease);
  }
  .btn-checkout:hover { transform: translateY(-2px); box-shadow: 0 12px 30px rgba(255,159,69,.38); }
  .btn-checkout:hover::after { left: 115%; }
  .btn-checkout:active { transform: translateY(0); }

  .btn-ghost {
    display: flex; align-items: center; justify-content: center; gap: 8px;
    width: 100%; margin-top: 10px; padding: 14px 22px;
    border: 1px solid var(--line); border-radius: var(--r-md); background: var(--surface);
    font-size: .925rem; font-weight: 500; color: var(--ink-2); cursor: pointer;
    transition: all .2s var(--ease);
  }
  .btn-ghost:hover { background: var(--brand-050); border-color: var(--brand-200); color: var(--brand-dark); }

  .trust { border-top: 1px solid var(--line-2); background: var(--canvas); padding: 16px 24px; display: grid; gap: 10px; }
  .trust__item { display: flex; align-items: center; gap: 9px; font-size: .8rem; color: var(--muted); font-weight: 300; }
  .trust__item svg { flex: none; color: var(--brand-dark); }

  /* ---------- Upsell ---------- */
  .up { margin-top: 44px; }
  .up__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 20px; flex-wrap: wrap; }
  .up__title { margin: 0 0 4px; font-size: 1.35rem; font-weight: 600; letter-spacing: -.015em; }
  .up__sub { margin: 0; font-size: .9rem; color: var(--muted); font-weight: 300; }
  .up__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(216px, 1fr)); gap: 18px; }
  .up__card {
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg);
    padding: 14px; display: flex; flex-direction: column;
    transition: transform .25s var(--ease), box-shadow .25s var(--ease), border-color .25s var(--ease);
  }
  .up__card:hover { transform: translateY(-4px); border-color: var(--brand-200); box-shadow: 0 12px 28px rgba(255,159,69,.16); }
  .up__media { position: relative; border-radius: var(--r-md); overflow: hidden; background: var(--line-2); aspect-ratio: 1 / 1; margin-bottom: 12px; }
  .up__media img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s var(--ease); }
  .up__card:hover .up__media img { transform: scale(1.05); }
  .up__badge {
    position: absolute; top: 10px; left: 10px;
    background: var(--brand); color: #fff; font-size: .68rem; font-weight: 600;
    letter-spacing: .06em; text-transform: uppercase; padding: 4px 9px; border-radius: 999px;
  }
  .up__name {
    font-size: .9rem; font-weight: 500; line-height: 1.45; margin: 0 0 6px;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .up__price { font-size: 1.05rem; font-weight: 600; color: var(--brand-dark); margin: 0 0 12px; letter-spacing: -.01em; }
  .up__price s { font-size: .82rem; font-weight: 400; color: var(--muted); margin-left: 6px; }
  .up__btn {
    margin-top: auto; width: 100%; padding: 11px 16px; cursor: pointer;
    border: 1px solid var(--brand); border-radius: var(--r-sm);
    background: var(--brand-050); color: var(--brand-dark);
    font-size: .875rem; font-weight: 600; letter-spacing: .01em;
    transition: all .2s var(--ease);
  }
  .up__btn:hover:not(:disabled) { background: var(--brand); color: #fff; box-shadow: 0 6px 16px rgba(255,159,69,.3); }
  .up__btn:disabled { opacity: .55; cursor: not-allowed; }

  /* ---------- Empty ---------- */
  .empty {
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg);
    box-shadow: var(--shadow-sm); text-align: center; padding: 80px 28px;
  }
  .empty__icon {
    width: 88px; height: 88px; margin: 0 auto 24px; border-radius: 50%;
    display: grid; place-items: center; color: var(--brand-dark);
    background: linear-gradient(135deg, var(--brand-050), var(--brand-100));
    border: 1px solid var(--brand-100);
  }
  .empty h2 { margin: 0 0 10px; font-size: 1.5rem; font-weight: 600; letter-spacing: -.02em; }
  .empty p { margin: 0 auto 28px; max-width: 380px; color: var(--muted); font-weight: 300; }
  .empty__btn {
    display: inline-flex; align-items: center; gap: 9px;
    padding: 14px 34px; border-radius: var(--r-md);
    background: linear-gradient(135deg, var(--brand) 0%, var(--brand-dark) 100%);
    color: #fff; font-weight: 600; font-size: .95rem; box-shadow: var(--shadow-brand);
    transition: transform .2s var(--ease), box-shadow .2s var(--ease);
  }
  .empty__btn:hover { transform: translateY(-2px); box-shadow: 0 12px 30px rgba(255,159,69,.38); }

  /* ---------- Loading + toast ---------- */
  .cartx.is-busy { pointer-events: none; }
  .cartx.is-busy .panel, .cartx.is-busy .sum { opacity: .55; transition: opacity .2s var(--ease); }

  .toastx {
    position: fixed; bottom: 24px; right: 24px; z-index: 9999;
    display: flex; align-items: center; gap: 10px;
    background: #16130F; color: #fff;
    padding: 14px 20px; border-radius: 12px;
    box-shadow: 0 12px 32px rgba(0,0,0,.22);
    font-family: 'Poppins', sans-serif; font-size: .9rem; font-weight: 400;
    border-left: 3px solid {{ section.settings.color_accent }};
    animation: toastIn .32s cubic-bezier(.4,0,.2,1);
  }
  .toastx.is-out { animation: toastOut .3s cubic-bezier(.4,0,.2,1) forwards; }
  .toastx svg { color: {{ section.settings.color_accent }}; flex: none; }
  @keyframes toastIn  { from { opacity: 0; transform: translateY(12px) scale(.96); } to { opacity: 1; transform: none; } }
  @keyframes toastOut { to { opacity: 0; transform: translateY(12px) scale(.96); } }

  .visually-hidden {
    position: absolute !important; width: 1px; height: 1px; overflow: hidden;
    clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 1080px) {
    .cartx__grid { grid-template-columns: 1fr; }
    .sum { position: static; }
  }

  @media (max-width: 749px) {
    .cartx__inner { padding: 32px 16px 64px; }
    .panel__head { display: none; }
    .ci {
      grid-template-columns: 84px minmax(0,1fr);
      grid-template-areas:
        "media info"
        "media price"
        "qty   total";
      gap: 14px; padding: 18px 16px;
    }
    .ci__media { grid-area: media; width: 84px; height: 84px; }
    .ci__info  { grid-area: info; }
    .ci__price { grid-area: price; text-align: left; font-size: .85rem; }
    .qty       { grid-area: qty; margin: 0; width: 112px; }
    .ci__total { grid-area: total; }
    .ship { padding: 16px; }
    .up__grid { grid-template-columns: repeat(2, minmax(0,1fr)); gap: 12px; }
    .empty { padding: 60px 20px; }
    .toastx { left: 16px; right: 16px; bottom: 16px; justify-content: center; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cartx *, .cartx *::before, .cartx *::after { animation: none !important; transition: none !important; }
  }
</style>

<div class="cartx" data-section="{{ section.id }}">
  <div class="cartx__inner">

    <!-- ======================= HEADER ======================= -->
    <header class="cartx__head">
      <span class="cartx__eyebrow">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
        {{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %}
      </span>
      <h1 class="cartx__title">{{ section.settings.heading | default: 'Your Cart' }}</h1>
      <p class="cartx__sub">{{ section.settings.subheading | default: 'Review your items and continue to secure checkout.' }}</p>
    </header>

    {%- if cart.item_count > 0 -%}

      <!-- ================= FREE SHIPPING METER ================= -->
      {%- if section.settings.show_shipping_bar and threshold > 0 -%}
        <div class="ship {% if remaining <= 0 %}ship--done{% endif %}">
          <div class="ship__row">
            <span class="ship__icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="1.5"/><path d="M16 8h4l3 3v5h-7z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            </span>
            {%- if remaining > 0 -%}
              <p class="ship__text">You&rsquo;re <b>{{ remaining | money }}</b> away from <b>free shipping</b>.</p>
            {%- else -%}
              <p class="ship__text">Nice &mdash; you&rsquo;ve unlocked <b>free shipping</b>!</p>
            {%- endif -%}
          </div>
          <div class="ship__bar" role="progressbar" aria-valuenow="{{ progress }}" aria-valuemin="0" aria-valuemax="100">
            <div class="ship__fill" style="width: {{ progress }}%;"></div>
          </div>
        </div>
      {%- endif -%}

      <form action="{{ routes.cart_url }}" method="post" novalidate id="CartForm-{{ section.id }}">
        <div class="cartx__grid">

          <!-- ================= LINE ITEMS ================= -->
          <div class="panel">
            <div class="panel__head">
              <span>Item</span><span></span><span>Quantity</span><span>Price</span><span>Total</span>
            </div>

            {%- for item in cart.items -%}
              <div class="ci" data-line="{{ forloop.index }}">

                <a class="ci__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                  {%- if item.image -%}
                    <img src="{{ item.image | image_url: width: 240 }}"
                         alt="{{ item.image.alt | escape }}"
                         width="96" height="96" loading="lazy">
                  {%- else -%}
                    <span class="ci__ph">
                      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                    </span>
                  {%- endif -%}
                </a>

                <div class="ci__info">
                  <a class="ci__name" href="{{ item.url }}">{{ item.product.title }}</a>

                  <div class="ci__meta">
                    {%- unless item.product.has_only_default_variant -%}
                      {%- for option in item.options_with_values -%}
                        <span class="ci__chip">{{ option.name }}: {{ option.value }}</span>
                      {%- endfor -%}
                    {%- endunless -%}
                    {%- if item.selling_plan_allocation -%}
                      <span class="ci__chip">{{ item.selling_plan_allocation.selling_plan.name }}</span>
                    {%- endif -%}
                    {%- for prop in item.properties -%}
                      {%- unless prop.last == blank or prop.first == '_' -%}
                        <span class="ci__chip">{{ prop.first }}: {{ prop.last }}</span>
                      {%- endunless -%}
                    {%- endfor -%}
                  </div>

                  {%- for alloc in item.line_level_discount_allocations -%}
                    <span class="ci__discount">
                      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                      {{ alloc.discount_application.title }} (&minus;{{ alloc.amount | money }})
                    </span>
                  {%- endfor -%}

                  <span class="ci__unit-m">{{ item.final_price | money }} each</span>
                </div>

                <div class="qty">
                  <button type="button" class="qty__btn" data-qty="down"
                          aria-label="Decrease quantity for {{ item.product.title | escape }}"
                          {% if item.quantity <= 1 %}disabled{% endif %}>&minus;</button>
                  <label class="visually-hidden" for="Qty-{{ section.id }}-{{ forloop.index }}">Quantity</label>
                  <input class="qty__input" type="number" inputmode="numeric" min="0" step="1"
                         id="Qty-{{ section.id }}-{{ forloop.index }}"
                         name="updates[]" value="{{ item.quantity }}"
                         data-line="{{ forloop.index }}">
                  <button type="button" class="qty__btn" data-qty="up"
                          aria-label="Increase quantity for {{ item.product.title | escape }}">&plus;</button>
                </div>

                <div class="ci__price">{{ item.final_price | money }}</div>

                <div class="ci__total">
                  <span class="ci__total-now">{{ item.final_line_price | money }}</span>
                  {%- if item.original_line_price > item.final_line_price -%}
                    <span class="ci__total-was">{{ item.original_line_price | money }}</span>
                  {%- endif -%}
                  <a class="ci__remove" href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0"
                     data-remove="{{ forloop.index }}">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></svg>
                    Remove
                  </a>
                </div>
              </div>
            {%- endfor -%}

            {%- if section.settings.show_note -%}
              <div class="note">
                <label class="note__label" for="CartNote-{{ section.id }}">Order note (optional)</label>
                <textarea id="CartNote-{{ section.id }}" name="note" placeholder="Delivery instructions, gift message, anything else&hellip;">{{ cart.note }}</textarea>
              </div>
            {%- endif -%}

            <noscript>
              <div style="padding:16px 24px;border-top:1px solid #EFE6DA;">
                <button type="submit" name="update" class="btn-ghost" style="margin:0;">Update cart</button>
              </div>
            </noscript>
          </div>

          <!-- ================= ORDER SUMMARY ================= -->
          <aside class="sum">
            <div class="sum__head">
              <h2 class="sum__title">Order Summary</h2>
            </div>

            <dl class="sum__body">
              <div class="sum__row">
                <dt>Subtotal</dt>
                <dd>{{ cart.items_subtotal_price | money }}</dd>
              </div>

              {%- for discount in cart.cart_level_discount_applications -%}
                <div class="sum__row sum__row--save">
                  <dt>{{ discount.title }}</dt>
                  <dd>&minus;{{ discount.total_allocated_amount | money }}</dd>
                </div>
              {%- endfor -%}

              <div class="sum__row sum__row--muted">
                <dt>Shipping</dt>
                <dd>{% if threshold > 0 and remaining <= 0 %}Free{% else %}Calculated at checkout{% endif %}</dd>
              </div>

              <div class="sum__row sum__row--muted">
                <dt>Taxes</dt>
                <dd>Calculated at checkout</dd>
              </div>
            </dl>

            <div class="sum__total">
              <span class="sum__total-l">
                Total
                <small>{{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %} &middot; {{ cart.currency.iso_code }}</small>
              </span>
              <span class="sum__total-v">{{ cart.total_price | money }}</span>
            </div>

            <div class="sum__actions">
              <button type="submit" name="checkout" class="btn-checkout">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                Proceed to Checkout
              </button>

              <a href="{{ continue_url }}" class="btn-ghost">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
                Continue Shopping
              </a>

              {%- if additional_checkout_buttons -%}
                <div style="margin-top:14px;">{{ content_for_additional_checkout_buttons }}</div>
              {%- endif -%}
            </div>

            <div class="trust">
              <span class="trust__item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                Secure, encrypted checkout
              </span>
              <span class="trust__item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="1.5"/><path d="M16 8h4l3 3v5h-7z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                Fast, tracked delivery
              </span>
              <span class="trust__item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>
                Easy returns &amp; exchanges
              </span>
            </div>
          </aside>
        </div>
      </form>

    {%- else -%}

      <!-- ================= EMPTY STATE ================= -->
      <div class="empty">
        <div class="empty__icon">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        </div>
        <h2>Your cart is empty</h2>
        <p>Looks like you haven&rsquo;t added anything yet. Explore the collection and find something you&rsquo;ll love.</p>
        <a href="{{ continue_url }}" class="empty__btn">
          Start Shopping
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

    {%- endif -%}

    <!-- ================= UPSELL ================= -->
    {%- assign upsell = collections[section.settings.upsell_collection] -%}
    {%- if upsell != blank and upsell.products_count > 0 -%}
      <section class="up">
        <div class="up__head">
          <div>
            <h2 class="up__title">{{ section.settings.upsell_heading | default: 'You might also like' }}</h2>
            <p class="up__sub">{{ section.settings.upsell_subheading | default: 'Small additions our customers love pairing with their order.' }}</p>
          </div>
          <a href="{{ upsell.url }}" class="btn-ghost" style="width:auto;margin:0;padding:10px 18px;">
            View all
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>

        <div class="up__grid">
          {%- for product in upsell.products limit: section.settings.upsell_limit -%}
            <div class="up__card">
              <a class="up__media" href="{{ product.url }}">
                {%- if product.featured_image -%}
                  <img src="{{ product.featured_image | image_url: width: 400 }}"
                       alt="{{ product.featured_image.alt | escape }}"
                       width="400" height="400" loading="lazy">
                {%- endif -%}
                {%- if product.compare_at_price > product.price -%}
                  <span class="up__badge">Sale</span>
                {%- endif -%}
              </a>

              <h3 class="up__name"><a href="{{ product.url }}">{{ product.title }}</a></h3>
              <p class="up__price">
                {{ product.price | money }}
                {%- if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif -%}
              </p>

              {%- if product.available -%}
                <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" class="up__form">
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  <input type="hidden" name="quantity" value="1">
                  <button type="submit" class="up__btn">Quick Add</button>
                </form>
              {%- else -%}
                <button type="button" class="up__btn" disabled>Sold Out</button>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </section>
    {%- endif -%}

  </div>
</div>

<script>
(function () {
  if (window.__cartxBound) return;
  window.__cartxBound = true;

  var ROOT = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';

  function sectionEl() { return document.querySelector('.cartx[data-section]'); }
  function sectionId() { var el = sectionEl(); return el ? el.getAttribute('data-section') : null; }

  function busy(on) {
    var el = sectionEl();
    if (el) el.classList.toggle('is-busy', !!on);
  }

  function toast(message) {
    document.querySelectorAll('.toastx').forEach(function (t) { t.remove(); });
    var t = document.createElement('div');
    t.className = 'toastx';
    t.setAttribute('role', 'status');
    t.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg><span></span>';
    t.querySelector('span').textContent = message;
    document.body.appendChild(t);
    setTimeout(function () {
      t.classList.add('is-out');
      setTimeout(function () { t.remove(); }, 300);
    }, 2600);
  }

  function render(html) {
    var id = sectionId();
    var wrap = id && document.getElementById('shopify-section-' + id);
    if (!wrap || !html) { window.location.reload(); return; }
    var doc = new DOMParser().parseFromString(html, 'text/html');
    var incoming = doc.getElementById('shopify-section-' + id);
    wrap.innerHTML = incoming ? incoming.innerHTML : doc.body.innerHTML;
    busy(false);
  }

  function post(url, payload) {
    var id = sectionId();
    if (id) {
      payload.sections = id;
      payload.sections_url = window.location.pathname;
    }
    busy(true);
    return fetch(ROOT + url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify(payload)
    })
      .then(function (r) { return r.json(); })
      .catch(function () { busy(false); window.location.reload(); });
  }

  function changeLine(line, quantity) {
    return post('cart/change.js', { line: line, quantity: quantity }).then(function (data) {
      if (!data) return;
      var id = sectionId();
      render(data.sections && id ? data.sections[id] : null);
      document.dispatchEvent(new CustomEvent('cart:updated', { detail: { cart: data } }));
    });
  }

  /* Quantity stepper */
  document.addEventListener('click', function (e) {
    var btn = e.target.closest('.cartx [data-qty]');
    if (!btn) return;
    var input = btn.parentElement.querySelector('.qty__input');
    if (!input) return;
    var current = parseInt(input.value, 10) || 0;
    var next = btn.getAttribute('data-qty') === 'up' ? current + 1 : current - 1;
    if (next < 0) next = 0;
    input.value = next;
    changeLine(parseInt(input.getAttribute('data-line'), 10), next);
  });

  /* Typed quantity */
  document.addEventListener('change', function (e) {
    var input = e.target.closest('.cartx .qty__input');
    if (!input) return;
    var q = parseInt(input.value, 10);
    if (isNaN(q) || q < 0) q = 0;
    changeLine(parseInt(input.getAttribute('data-line'), 10), q);
  });

  /* Remove */
  document.addEventListener('click', function (e) {
    var link = e.target.closest('.cartx [data-remove]');
    if (!link) return;
    e.preventDefault();
    changeLine(parseInt(link.getAttribute('data-remove'), 10), 0).then(function () {
      toast('Item removed from your cart');
    });
  });

  /* Quick add */
  document.addEventListener('submit', function (e) {
    var form = e.target.closest('.cartx .up__form');
    if (!form) return;
    e.preventDefault();
    var btn = form.querySelector('button');
    var label = btn ? btn.textContent : '';
    if (btn) { btn.disabled = true; btn.textContent = 'Adding...'; }

    post('cart/add.js', {
      items: [{ id: Number(form.querySelector('[name="id"]').value), quantity: 1 }]
    }).then(function (data) {
      if (!data) return;
      if (data.status && data.status >= 400) {
        if (btn) { btn.disabled = false; btn.textContent = label; }
        busy(false);
        toast(data.description || 'Could not add that item');
        return;
      }
      var id = sectionId();
      render(data.sections && id ? data.sections[id] : null);
      toast('Added to your cart');
      document.dispatchEvent(new CustomEvent('cart:updated', { detail: { cart: data } }));
    });
  });
})();
</script>

{% schema %}
{
  "name": "Cart page",
  "tag": "section",
  "class": "cartx-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your Cart" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Review your items and continue to secure checkout." },
    { "type": "url", "id": "continue_url", "label": "Continue shopping link" },
    { "type": "checkbox", "id": "show_note", "label": "Show order note", "default": true },

    { "type": "header", "content": "Free shipping bar" },
    { "type": "checkbox", "id": "show_shipping_bar", "label": "Show free shipping progress", "default": true },
    { "type": "number", "id": "free_shipping_threshold", "label": "Free shipping threshold (store currency, e.g. 999)", "default": 999 },

    { "type": "header", "content": "Upsell" },
    { "type": "collection", "id": "upsell_collection", "label": "Upsell collection" },
    { "type": "text", "id": "upsell_heading", "label": "Upsell heading", "default": "You might also like" },
    { "type": "text", "id": "upsell_subheading", "label": "Upsell subheading", "default": "Small additions our customers love pairing with their order." },
    { "type": "range", "id": "upsell_limit", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 4 },

    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "color_accent", "label": "Accent", "default": "#FF9F45" },
    { "type": "color", "id": "color_accent_dark", "label": "Accent (dark)", "default": "#E8801F" },
    { "type": "color", "id": "color_soft", "label": "Soft background", "default": "#FFF6EB" }
  ],
  "presets": [{ "name": "Cart page" }]
}
{% endschema %}