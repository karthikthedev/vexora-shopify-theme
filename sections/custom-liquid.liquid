{%- style -%}
  .collection-products {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .collection-products {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .collection-products {
    background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
  }

  .collection-products__inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .collection-products__header {
    text-align: center;
    margin-bottom: 48px;
  }

  .collection-products__heading {
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 700;
    color: #1a1a1a;
    margin: 0 0 12px 0;
    letter-spacing: -0.02em;
  }

  .collection-products__subheading {
    font-size: 1.05rem;
    color: #666;
    margin: 0;
    font-weight: 400;
  }

  .collection-products__scroll-wrapper {
    position: relative;
    margin-bottom: 40px;
  }

  .collection-products__grid {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-behavior: smooth;
    padding-bottom: 12px;
    margin-bottom: -12px;
  }

  .collection-products__grid::-webkit-scrollbar {
    height: 8px;
  }

  .collection-products__grid::-webkit-scrollbar-track {
    background: #f0f0f0;
    border-radius: 10px;
  }

  .collection-products__grid::-webkit-scrollbar-thumb {
    background: #d0d0d0;
    border-radius: 10px;
  }

  .collection-products__grid::-webkit-scrollbar-thumb:hover {
    background: #b0b0b0;
  }

  .collection-products__scroll-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: #f97316;
    border: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    box-shadow: 0 2px 8px rgba(249, 115, 22, 0.2);
    transition: all 0.2s ease;
    font-size: 20px;
    color: white;
  }

  .collection-products__scroll-arrow:hover {
    background: #e8660d;
    box-shadow: 0 4px 12px rgba(249, 115, 22, 0.3);
  }

  .collection-products__scroll-arrow--left {
    left: -22px;
  }

  .collection-products__scroll-arrow--right {
    right: -22px;
  }

  .product-card {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    display: flex;
    flex-direction: column;
    height: 100%;
    flex-shrink: 0;
    width: 200px;
  }

  .product-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.12);
  }

  .product-card__image {
    position: relative;
    width: 100%;
    height: 160px;
    overflow: hidden;
    background: #f5f5f5;
  }

  .product-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .product-card:hover .product-card__image img {
    transform: scale(1.08);
  }

  .product-card__badge {
    position: absolute;
    top: 12px;
    right: 12px;
    background: #f97316;
    color: white;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    z-index: 2;
  }

  .product-card__content {
    padding: 10px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .product-card__vendor {
    font-size: 0.75rem;
    color: #f97316;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 4px;
    display: none;
  }

  .product-card__title {
    font-size: 1.05rem;
    font-weight: 600;
    color: #1a1a1a;
    margin: 0;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-card__rating {
    display: none;
    align-items: center;
    gap: 6px;
    margin-bottom: 8px;
  }

  .product-card__stars {
    display: flex;
    gap: 2px;
    color: #f59e0b;
  }

  .product-card__rating-text {
    font-size: 0.85rem;
    color: #666;
  }

  .product-card__price {
    margin-top: auto;
    padding-top: 8px;
    margin-bottom: 8px;
  }

  .product-card__price-value {
    font-size: 1rem;
    font-weight: 700;
    color: #1a1a1a;
  }

  .product-card__price-original {
    font-size: 0.8rem;
    color: #999;
    text-decoration: line-through;
    margin-left: 6px;
  }

  .product-card__cta {
    display: flex;
    gap: 6px;
  }

  .product-card__btn {
    flex: 1;
    padding: 8px 12px;
    border: none;
    border-radius: 6px;
    font-weight: 500;
    font-size: 0.8rem;
    cursor: pointer;
    transition: all 0.2s ease;
    text-decoration: none;
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .product-card__btn--primary {
    display: none;
  }

  .product-card__btn--secondary {
    display: none;
    background: #f5f5f5;
    color: #1a1a1a;
    border: 1.5px solid #e0e0e0;
    width: 100%;
  }

  .product-card__btn--secondary:hover {
    background: #f97316;
    color: white;
    border-color: #f97316;
  }

  .empty-state {
    text-align: center;
    padding: 60px 20px;
  }

  .empty-state__icon {
    font-size: 48px;
    margin-bottom: 16px;
  }

  .empty-state__title {
    font-size: 1.5rem;
    font-weight: 600;
    color: #1a1a1a;
    margin-bottom: 8px;
  }

  .empty-state__text {
    color: #666;
    margin-bottom: 0;
  }

  @media (max-width: 750px) {
    .collection-products__header {
      margin-bottom: 32px;
    }

    .collection-products__heading {
      font-size: clamp(1.5rem, 4vw, 2rem);
    }
  }
{%- endstyle -%}

<div class="collection-products">
  <div class="collection-products__inner">
    {%- if product.collections.size > 1 -%}
      {%- assign current_collection = product.collections[1] -%}
      <div class="collection-products__header">
        <h2 class="collection-products__heading">More from {{ current_collection.title }}</h2>
        <p class="collection-products__subheading">Explore similar products from this collection</p>
      </div>

      {%- if current_collection.products_count > 1 -%}
        <div class="collection-products__scroll-wrapper">
          <button class="collection-products__scroll-arrow collection-products__scroll-arrow--left" onclick="document.querySelector('.collection-products__grid').scrollBy({left: -250, behavior: 'smooth'})" aria-label="Scroll left">
            &#10094;
          </button>
          <div class="collection-products__grid">
          {%- assign count = 0 -%}
          {%- for item in current_collection.products limit: section.settings.products_to_show -%}
            {%- if item.id != product.id -%}
              <div class="product-card">
                <div class="product-card__image">
                  {%- if item.featured_image -%}
                    <img 
                      src="{{ item.featured_image | image_url: width: 500 }}" 
                      alt="{{ item.title }}"
                      loading="lazy"
                    >
                  {%- endif -%}
                  {%- if item.compare_at_price > item.price -%}
                    {%- assign discount = item.compare_at_price | minus: item.price | times: 100 | divided_by: item.compare_at_price | round -%}
                    <span class="product-card__badge">-{{ discount }}%</span>
                  {%- endif -%}
                </div>

                <div class="product-card__content">
                  {%- if section.settings.show_vendor and item.vendor -%}
                    <div class="product-card__vendor">{{ item.vendor }}</div>
                  {%- endif -%}

                  <h3 class="product-card__title">
                    <a href="{{ item.url }}" style="color: inherit; text-decoration: none;">
                      {{ item.title }}
                    </a>
                  </h3>

                  {%- if section.settings.show_rating -%}
                    {%- if item.metafields.reviews.rating.value -%}
                      {%- assign rounded_rating = item.metafields.reviews.rating.value | round -%}
                      <div class="product-card__rating">
                        <div class="product-card__stars">
                          {%- for i in (1..5) -%}
                            {%- if i <= rounded_rating -%}
                              ★
                            {%- else -%}
                              ☆
                            {%- endif -%}
                          {%- endfor -%}
                        </div>
                        <span class="product-card__rating-text">({{ item.metafields.reviews.rating.value | round: 1 }})</span>
                      </div>
                    {%- endif -%}
                  {%- endif -%}

                  <div class="product-card__price">
                    <span class="product-card__price-value">
                      {{ item.price | money }}
                    </span>
                    {%- if item.compare_at_price > item.price -%}
                      <span class="product-card__price-original">{{ item.compare_at_price | money }}</span>
                    {%- endif -%}
                  </div>

                  <div class="product-card__cta">
                    <a 
                      href="{{ item.url }}" 
                      class="product-card__btn product-card__btn--primary"
                    >
                      View Details
                    </a>
                    <button 
                      class="product-card__btn product-card__btn--secondary"
                      data-product-id="{{ item.id }}"
                      onclick="fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ items: [{ id: this.getAttribute('data-product-id'), quantity: 1 }] }) }).then(() => location.reload())"
                      title="Quick add to cart"
                    >
                      +
                    </button>
                  </div>
                </div>
              </div>
              {%- assign count = count | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
          <button class="collection-products__scroll-arrow collection-products__scroll-arrow--right" onclick="document.querySelector('.collection-products__grid').scrollBy({left: 250, behavior: 'smooth'})" aria-label="Scroll right">
            &#10095;
          </button>
        </div>

        {%- assign product_limit = section.settings.products_to_show | plus: 1 -%}
        {%- if current_collection.products_count > product_limit -%}
          <div style="text-align: center;">
            <a 
              href="{{ current_collection.url }}" 
              class="product-card__btn"
              style="display: inline-flex; padding: 14px 32px; font-size: 1rem; background: #f97316; color: white; border: none;"
              onmouseover="this.style.background='#e8660d'"
              onmouseout="this.style.background='#f97316'"
            >
              View All Products in {{ current_collection.title }}
            </a>
          </div>
        {%- endif -%}
      {%- else -%}
        <div class="empty-state">
          <div class="empty-state__icon">📦</div>
          <h3 class="empty-state__title">No More Products</h3>
          <p class="empty-state__text">This is the only product in this collection</p>
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="empty-state">
        <div class="empty-state__icon">🔍</div>
        <h3 class="empty-state__title">No Collection</h3>
        <p class="empty-state__text">This product is not assigned to any collection</p>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Collection Products",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "This section automatically displays products from the same collection as the current product with an enhanced UI/UX design."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8,
      "label": "Products to show"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": true,
      "label": "Show vendor"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": true,
      "label": "Show rating"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Collection Products"
    }
  ]
}
{% endschema %}
