<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
/* ─── Global overflow fix ─────────────────────────────────────── */
html, body {
  overflow-x: hidden;
}

/* ─── Tokens ──────────────────────────────────────────────────── */
#vxnav-{{ section.id }} {
  --bg:        #FFF3E4;
  --bg-blur:   rgba(255, 243, 228, 0.88);
  --primary:   #F97316;
  --secondary: #FB923C;
  --white:     #FFFFFF;
  --ink:       #111827;
  --ink-55:    rgba(17,24,39,0.55);
  --ink-08:    rgba(17,24,39,0.08);
  --ink-12:    rgba(17,24,39,0.12);
  --shadow-sm: 0 2px 16px rgba(17,24,39,0.07);
  --shadow-md: 0 12px 40px rgba(17,24,39,0.11);
  --f-disp:    'Playfair Display', Georgia, serif;
  --f-body:    'Jost', system-ui, sans-serif;
  --nav-h:     72px;
  --radius:    14px;
}

/* ─── Sticky bar ─────────────────────────────────────────────── */
#vxnav-{{ section.id }} {
  position: sticky;
  top: 0;
  z-index: 9000;
  width: 100%;
  font-family: var(--f-body);
}

#vxnav-{{ section.id }} .vxnav-bar {
  background: var(--bg-blur);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  border-bottom: 1px solid var(--ink-08);
  height: var(--nav-h);
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  padding: 0 28px;
  transition: box-shadow 0.3s ease, background 0.3s ease;
  position: relative;
  z-index: 10;
}
#vxnav-{{ section.id }} .vxnav-bar.is-scrolled {
  box-shadow: var(--shadow-sm);
  background: rgba(255, 243, 228, 0.97);
}

/* ─── Left zone ──────────────────────────────────────────────── */
#vxnav-{{ section.id }} .vxnav-left {
  display: flex;
  align-items: center;
  gap: 8px;
  justify-content: flex-start;
}

/* ── Hamburger button ── */
#vxnav-{{ section.id }} .vxnav-burger {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  border: 1.5px solid var(--ink-12);
  background: transparent;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5px;
  padding: 0;
  flex-shrink: 0;
  transition: border-color 0.2s, background 0.2s;
  position: relative;
  z-index: 20;
  color: var(--primary);
}
#vxnav-{{ section.id }} .vxnav-burger:hover {
  border-color: var(--primary);
  background: rgba(249,115,22,0.06);
}
#vxnav-{{ section.id }} .vxnav-burger span {
  display: block;
  width: 18px;
  height: 1.8px;
  background: var(--primary);
  border-radius: 2px;
  transform-origin: center;
  transition: transform 0.35s cubic-bezier(.22,1,.36,1),
              opacity 0.25s ease,
              width 0.25s ease;
}
/* X state */
#vxnav-{{ section.id }} .vxnav-burger.is-open span:nth-child(1) {
  transform: translateY(6.8px) rotate(45deg);
}
#vxnav-{{ section.id }} .vxnav-burger.is-open span:nth-child(2) {
  opacity: 0;
  width: 0;
}
#vxnav-{{ section.id }} .vxnav-burger.is-open span:nth-child(3) {
  transform: translateY(-6.8px) rotate(-45deg);
}

/* ─── Center: Logo ───────────────────────────────────────────── */
#vxnav-{{ section.id }} .vxnav-logo {
  display: flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  gap: 10px;
  flex-shrink: 0;
}
#vxnav-{{ section.id }} .vxnav-logo img {
  height: 54px;
  width: auto;
  display: block;
  object-fit: contain;
  transform: scale(1.05);
}
#vxnav-{{ section.id }} .vxnav-logo-text {
  font-family: var(--f-disp);
  font-size: 3rem;
  font-weight: 1000;
  color: var(--ink);
  letter-spacing: -0.02em;
  line-height: 1;
  white-space: nowrap;
}
#vxnav-{{ section.id }} .vxnav-logo-text span {
  color: var(--primary);
}

/* ─── Right zone ─────────────────────────────────────────────── */
#vxnav-{{ section.id }} .vxnav-right {
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

/* Cart button */
#vxnav-{{ section.id }} .vxnav-cart {
  position: relative;
  width: 44px;
  height: 44px;
  border-radius: 12px;
  border: 1.5px solid var(--ink-12);
  background: transparent;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  color: var(--primary);
  transition: border-color 0.2s, background 0.2s, color 0.2s;
  flex-shrink: 0;
}
#vxnav-{{ section.id }} .vxnav-cart:hover {
  border-color: var(--primary);
  background: rgba(249,115,22,0.06);
  color: var(--primary);
}
#vxnav-{{ section.id }} .vxnav-cart svg {
  transition: transform 0.2s ease;
}
#vxnav-{{ section.id }} .vxnav-cart:hover svg {
  transform: scale(1.1);
}

/* Cart counter badge */
#vxnav-{{ section.id }} .vxnav-cart-count {
  position: absolute;
  top: -7px;
  right: -7px;
  min-width: 19px;
  height: 19px;
  padding: 0 5px;
  background: var(--primary);
  color: var(--white);
  font-size: 10.5px;
  font-weight: 700;
  font-family: var(--f-body);
  border-radius: 100px;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  border: 2px solid var(--bg);
  transition: transform 0.2s cubic-bezier(.34,1.56,.64,1), opacity 0.2s;
  pointer-events: none;
}
#vxnav-{{ section.id }} .vxnav-cart-count[data-count="0"] {
  transform: scale(0);
  opacity: 0;
}

/* ─── Drawer / Flyout Menu ───────────────────────────────────── */
#vxnav-{{ section.id }} .vxnav-drawer {
  position: fixed;
  top: var(--nav-h);
  left: 0;
  width: 320px;
  height: calc(100vh - var(--nav-h));
  background: rgba(255, 255, 255, 0.6);
backdrop-filter: blur(12px);
-webkit-backdrop-filter: blur(12px);
  border-right: 1px solid var(--ink-08);
  box-shadow: var(--shadow-md);
  transform: translateX(-100%);
  transition: transform 0.38s cubic-bezier(.22,1,.36,1);
  z-index: 8999;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
#vxnav-{{ section.id }} .vxnav-drawer.is-open {
  transform: translateX(0);
}

/* Drawer backdrop */
#vxnav-{{ section.id }} .vxnav-backdrop {
  position: fixed;
  inset: 0;
  top: var(--nav-h);
  background: rgba(17,24,39,0.30);
  backdrop-filter: blur(3px);
  -webkit-backdrop-filter: blur(3px);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.35s ease;
  z-index: 8998;
}
#vxnav-{{ section.id }} .vxnav-backdrop.is-open {
  opacity: 1;
  pointer-events: all;
}
#vxnav-{{ section.id }} .vxnav-close-btn {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  border: 1.5px solid var(--ink-12);
  background: transparent;
  cursor: pointer;
  font-size: 18px;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  color: var(--primary);
}

#vxnav-{{ section.id }} .vxnav-close-btn:hover {
  border-color: var(--primary);
  color: var(--primary);
  background: rgba(249,115,22,0.06);
}
/* Drawer header */
#vxnav-{{ section.id }} .vxnav-drawer-head {
  padding: 28px 28px 20px;
  border-bottom: 1px solid var(--ink-08);
  flex-shrink: 0;
}
#vxnav-{{ section.id }} .vxnav-drawer-head p {
  font-size: 10.5px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  font-weight: 600;
  color: var(--ink-55);
  margin: 0;
}

/* Drawer scroll body */
#vxnav-{{ section.id }} .vxnav-drawer-body {
  flex: 1;
  overflow-y: auto;
  padding: 12px 0 32px;
  scrollbar-width: thin;
  scrollbar-color: var(--ink-12) transparent;
}

/* Nav items */
#vxnav-{{ section.id }} .vxnav-item {
  display: block;
  width: 100%;
}

/* Top-level row (shared between link and toggle) */
#vxnav-{{ section.id }} .vxnav-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28px;
  height: 52px;
  text-decoration: none;
  color: var(--ink);
  font-size: 15px;
  font-weight: 500;
  letter-spacing: 0.01em;
  transition: background 0.18s, color 0.18s;
  cursor: pointer;
  border: none;
  background: transparent;
  width: 100%;
  text-align: left;
  font-family: var(--f-body);
  position: relative;
}
#vxnav-{{ section.id }} .vxnav-row::before {
  content: '';
  position: absolute;
  left: 0; top: 50%;
  transform: translateY(-50%) scaleY(0);
  width: 3px; height: 28px;
  background: var(--primary);
  border-radius: 0 3px 3px 0;
  transition: transform 0.2s ease;
}
#vxnav-{{ section.id }} .vxnav-row:hover,
#vxnav-{{ section.id }} .vxnav-row.is-active {
  background: rgba(249,115,22,0.06);
  color: var(--primary);
}
#vxnav-{{ section.id }} .vxnav-row:hover::before,
#vxnav-{{ section.id }} .vxnav-row.is-active::before {
  transform: translateY(-50%) scaleY(1);
}

/* Row chevron icon */
#vxnav-{{ section.id }} .vxnav-chevron {
  width: 18px; height: 18px;
  flex-shrink: 0;
  transition: transform 0.3s cubic-bezier(.22,1,.36,1);
  color: var(--ink-55);
}
#vxnav-{{ section.id }} .vxnav-row.is-active .vxnav-chevron {
  transform: rotate(180deg);
  color: var(--primary);
}

/* Row left icon */
#vxnav-{{ section.id }} .vxnav-row-icon {
  width: 32px; height: 32px;
  border-radius: 9px;
  background: rgba(249,115,22,0.10);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  margin-right: 12px;
  transition: background 0.2s;
}
#vxnav-{{ section.id }} .vxnav-row:hover .vxnav-row-icon,
#vxnav-{{ section.id }} .vxnav-row.is-active .vxnav-row-icon {
  background: rgba(249,115,22,0.18);
}
#vxnav-{{ section.id }} .vxnav-row-left {
  display: flex;
  align-items: center;
}

/* ─── Collections sub-dropdown ───────────────────────────────── */
#vxnav-{{ section.id }} .vxnav-sub {
  overflow: hidden;
  max-height: 0;
  transition: max-height 0.38s cubic-bezier(.22,1,.36,1);
  background: rgba(249,115,22,0.03);
  border-top: 1px solid transparent;
  border-bottom: 1px solid transparent;
}
#vxnav-{{ section.id }} .vxnav-sub.is-open {
  max-height: 400px;
  border-color: var(--ink-08);
}

#vxnav-{{ section.id }} .vxnav-sub-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 28px 12px 52px;
  text-decoration: none;
  color: var(--ink-55);
  font-size: 14px;
  font-weight: 400;
  transition: color 0.18s, padding-left 0.2s;
  position: relative;
}
#vxnav-{{ section.id }} .vxnav-sub-item::before {
  content: '';
  position: absolute;
  left: 36px; top: 50%;
  transform: translateY(-50%);
  width: 5px; height: 5px;
  border-radius: 50%;
  background: var(--ink-12);
  transition: background 0.2s, transform 0.2s;
}
#vxnav-{{ section.id }} .vxnav-sub-item:hover {
  color: var(--primary);
  padding-left: 58px;
}
#vxnav-{{ section.id }} .vxnav-sub-item:hover::before {
  background: var(--primary);
  transform: translateY(-50%) scale(1.4);
}

/* "Shop all" link inside sub */
#vxnav-{{ section.id }} .vxnav-sub-all {
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 8px 28px 4px 52px;
  padding: 9px 16px;
  background: var(--primary);
  color: var(--white);
  text-decoration: none;
  font-size: 12.5px;
  font-weight: 600;
  letter-spacing: 0.05em;
  border-radius: 100px;
  width: fit-content;
  transition: background 0.2s, transform 0.2s;
}
#vxnav-{{ section.id }} .vxnav-sub-all:hover {
  background: #e8660d;
  transform: translateX(3px);
}

/* Divider */
#vxnav-{{ section.id }} .vxnav-divider {
  height: 1px;
  background: var(--ink-08);
  margin: 8px 28px;
}

/* Drawer footer */
#vxnav-{{ section.id }} .vxnav-drawer-foot {
  padding: 20px 28px;
  border-top: 1px solid var(--ink-08);
  flex-shrink: 0;
}
#vxnav-{{ section.id }} .vxnav-foot-brand {
  font-family: var(--f-disp);
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: -0.01em;
}
#vxnav-{{ section.id }} .vxnav-foot-brand span { color: var(--primary); }
#vxnav-{{ section.id }} .vxnav-foot-tag {
  font-size: 11.5px;
  color: var(--ink-55);
  margin-top: 4px;
  font-weight: 300;
}

/* ─── Cart Drawer (right side) ───────────────────────────────── */
#vxnav-{{ section.id }} .vxnav-cart-btn {
  position: relative;
  width: 44px;
  height: 44px;
  border-radius: 12px;
  border: 1.5px solid var(--ink-12);
  background: transparent;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--primary);
  transition: border-color 0.2s, background 0.2s;
  flex-shrink: 0;
  padding: 0;
  font-family: var(--f-body);
}
#vxnav-{{ section.id }} .vxnav-cart-btn:hover {
  border-color: var(--primary);
  background: rgba(249,115,22,0.06);
}
#vxnav-{{ section.id }} .vxnav-cart-btn svg {
  transition: transform 0.2s ease;
}
#vxnav-{{ section.id }} .vxnav-cart-btn:hover svg {
  transform: scale(1.1);
}
#vxnav-{{ section.id }} .vxnav-cart-btn .vxnav-cart-count {
  position: absolute;
  top: -7px;
  right: -7px;
  min-width: 19px;
  height: 19px;
  padding: 0 5px;
  background: var(--primary);
  color: var(--white);
  font-size: 10.5px;
  font-weight: 700;
  font-family: var(--f-body);
  border-radius: 100px;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  border: 2px solid var(--bg);
  transition: transform 0.2s cubic-bezier(.34,1.56,.64,1), opacity 0.2s;
  pointer-events: none;
}
#vxnav-{{ section.id }} .vxnav-cart-btn .vxnav-cart-count[data-count="0"] {
  transform: scale(0);
  opacity: 0;
}

/* Cart panel slides from right */
#vxnav-{{ section.id }} .vxnav-cart-panel {
  position: fixed;
  top: var(--nav-h);
  right: 0;
  width: 380px;
  height: calc(100vh - var(--nav-h));
  background: var(--white);
  border-left: 1px solid var(--ink-08);
  box-shadow: -8px 0 40px rgba(17,24,39,0.10);
  transform: translateX(100%);
  transition: transform 0.38s cubic-bezier(.22,1,.36,1);
  z-index: 8999;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
#vxnav-{{ section.id }} .vxnav-cart-panel.is-open {
  transform: translateX(0);
}

/* Panel head */
#vxnav-{{ section.id }} .vxnav-cp-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22px 24px;
  border-bottom: 1px solid var(--ink-08);
  flex-shrink: 0;
}
#vxnav-{{ section.id }} .vxnav-cp-head-left {
  display: flex;
  align-items: center;
  gap: 10px;
}
#vxnav-{{ section.id }} .vxnav-cp-title {
  font-family: var(--f-disp);
  font-size: 1.2rem;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: -0.01em;
}
#vxnav-{{ section.id }} .vxnav-cp-count-pill {
  background: rgba(249,115,22,0.12);
  color: var(--primary);
  font-size: 11px;
  font-weight: 700;
  padding: 3px 9px;
  border-radius: 100px;
  font-family: var(--f-body);
}
#vxnav-{{ section.id }} .vxnav-cp-close {
  width: 34px; height: 34px;
  border-radius: 10px;
  border: 1.5px solid var(--ink-12);
  background: transparent;
  cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  color: var(--ink);
  transition: border-color 0.2s, background 0.2s, color 0.2s;
  flex-shrink: 0;
  padding: 0;
}
#vxnav-{{ section.id }} .vxnav-cp-close:hover {
  border-color: var(--primary);
  background: rgba(249,115,22,0.06);
  color: var(--primary);
}

/* Panel scrollable items list */
#vxnav-{{ section.id }} .vxnav-cp-items {
  flex: 1;
  overflow-y: auto;
  padding: 8px 0;
  scrollbar-width: thin;
  scrollbar-color: var(--ink-12) transparent;
}

/* Empty state */
#vxnav-{{ section.id }} .vxnav-cp-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  gap: 16px;
  padding: 40px;
  text-align: center;
}
#vxnav-{{ section.id }} .vxnav-cp-empty-icon {
  width: 64px; height: 64px;
  border-radius: 18px;
  background: rgba(249,115,22,0.08);
  display: flex; align-items: center; justify-content: center;
}
#vxnav-{{ section.id }} .vxnav-cp-empty h4 {
  font-family: var(--f-disp);
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--ink);
  margin: 0;
}
#vxnav-{{ section.id }} .vxnav-cp-empty p {
  font-size: 13.5px;
  color: var(--ink-55);
  font-weight: 300;
  line-height: 1.6;
  margin: 0;
}
#vxnav-{{ section.id }} .vxnav-cp-empty a {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: var(--primary);
  color: var(--white);
  font-family: var(--f-body);
  font-size: 13.5px;
  font-weight: 600;
  text-decoration: none;
  padding: 12px 24px;
  border-radius: 100px;
  margin-top: 4px;
  transition: background 0.2s, transform 0.2s;
  box-shadow: 0 6px 20px rgba(249,115,22,0.28);
}
#vxnav-{{ section.id }} .vxnav-cp-empty a:hover {
  background: #e8660d;
  transform: translateY(-2px);
}

/* Individual cart line item */
#vxnav-{{ section.id }} .vxnav-cp-item {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  padding: 16px 24px;
  border-bottom: 1px solid var(--ink-08);
  transition: background 0.15s;
  position: relative;
}
#vxnav-{{ section.id }} .vxnav-cp-item:last-child {
  border-bottom: none;
}
#vxnav-{{ section.id }} .vxnav-cp-item:hover {
  background: rgba(249,115,22,0.02);
}

/* Product thumbnail */
#vxnav-{{ section.id }} .vxnav-cp-img {
  width: 64px; height: 64px;
  border-radius: 12px;
  overflow: hidden;
  border: 1px solid var(--ink-08);
  background: #FFF3E4;
  flex-shrink: 0;
}
#vxnav-{{ section.id }} .vxnav-cp-img img {
  width: 100%; height: 100%;
  object-fit: cover;
  display: block;
}

/* Item info */
#vxnav-{{ section.id }} .vxnav-cp-info {
  flex: 1;
  min-width: 0;
}
#vxnav-{{ section.id }} .vxnav-cp-item-title {
  font-size: 13.5px;
  font-weight: 500;
  color: var(--ink);
  line-height: 1.3;
  margin: 0 0 4px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
#vxnav-{{ section.id }} .vxnav-cp-item-variant {
  font-size: 11.5px;
  color: var(--ink-55);
  font-weight: 300;
  margin: 0 0 10px;
}
#vxnav-{{ section.id }} .vxnav-cp-item-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}
#vxnav-{{ section.id }} .vxnav-cp-item-price {
  font-size: 14px;
  font-weight: 600;
  color: var(--primary);
  font-family: var(--f-body);
}

/* Qty controls */
#vxnav-{{ section.id }} .vxnav-cp-qty {
  display: flex;
  align-items: center;
  gap: 0;
  background: rgba(249,115,22,0.07);
  border-radius: 8px;
  overflow: hidden;
  border: 1px solid rgba(249,115,22,0.15);
}
#vxnav-{{ section.id }} .vxnav-cp-qty-btn {
  width: 28px; height: 28px;
  border: none;
  background: transparent;
  color: var(--primary);
  font-size: 16px;
  font-weight: 500;
  cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  transition: background 0.15s;
  padding: 0;
  line-height: 1;
  font-family: var(--f-body);
}
#vxnav-{{ section.id }} .vxnav-cp-qty-btn:hover {
  background: rgba(249,115,22,0.15);
}
#vxnav-{{ section.id }} .vxnav-cp-qty-val {
  font-size: 13px;
  font-weight: 600;
  color: var(--ink);
  min-width: 22px;
  text-align: center;
  font-family: var(--f-body);
}

/* Remove button */
#vxnav-{{ section.id }} .vxnav-cp-remove {
  position: absolute;
  top: 14px; right: 20px;
  width: 22px; height: 22px;
  border: none;
  background: transparent;
  color: rgba(17,24,39,0.25);
  cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  border-radius: 6px;
  transition: color 0.2s, background 0.2s;
  padding: 0;
}
#vxnav-{{ section.id }} .vxnav-cp-remove:hover {
  color: #EF4444;
  background: rgba(239,68,68,0.08);
}

/* Panel footer: totals + CTAs */
#vxnav-{{ section.id }} .vxnav-cp-foot {
  border-top: 1px solid var(--ink-08);
  padding: 20px 24px 24px;
  flex-shrink: 0;
  background: var(--white);
}

/* Subtotal row */
#vxnav-{{ section.id }} .vxnav-cp-subtotal {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6px;
}
#vxnav-{{ section.id }} .vxnav-cp-subtotal-label {
  font-size: 12px;
  letter-spacing: 0.10em;
  text-transform: uppercase;
  font-weight: 600;
  color: var(--ink-55);
}
#vxnav-{{ section.id }} .vxnav-cp-subtotal-val {
  font-family: var(--f-body);
  font-size: 1.45rem;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: -0.02em;
}

/* Shipping note */
#vxnav-{{ section.id }} .vxnav-cp-shipping-note {
  font-size: 11.5px;
  color: var(--ink-55);
  font-weight: 300;
  margin-bottom: 18px;
  display: flex;
  align-items: center;
  gap: 5px;
}
#vxnav-{{ section.id }} .vxnav-cp-shipping-note svg {
  color: var(--primary);
  flex-shrink: 0;
}

/* CTA buttons */
#vxnav-{{ section.id }} .vxnav-cp-actions {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
#vxnav-{{ section.id }} .vxnav-cp-btn-checkout {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  background: var(--primary);
  color: var(--white);
  font-family: var(--f-body);
  font-size: 14.5px;
  font-weight: 600;
  text-decoration: none;
  padding: 15px 24px;
  border-radius: 100px;
  border: none;
  cursor: pointer;
  transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
  box-shadow: 0 8px 24px rgba(249,115,22,0.30);
  letter-spacing: 0.02em;
  width: 100%;
}
#vxnav-{{ section.id }} .vxnav-cp-btn-checkout:hover {
  background: #e8660d;
  transform: translateY(-2px);
  box-shadow: 0 14px 32px rgba(249,115,22,0.38);
}
#vxnav-{{ section.id }} .vxnav-cp-btn-view {
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  color: var(--ink);
  font-family: var(--f-body);
  font-size: 14px;
  font-weight: 500;
  text-decoration: none;
  padding: 13px 24px;
  border-radius: 100px;
  border: 1.5px solid var(--ink-12);
  transition: border-color 0.2s, color 0.2s, background 0.2s;
  width: 100%;
}
#vxnav-{{ section.id }} .vxnav-cp-btn-view:hover {
  border-color: var(--primary);
  color: var(--primary);
  background: rgba(249,115,22,0.04);
}

/* Loading spinner inside panel */
#vxnav-{{ section.id }} .vxnav-cp-loading {
  display: none;
  align-items: center;
  justify-content: center;
  padding: 40px;
  flex: 1;
}
#vxnav-{{ section.id }} .vxnav-cp-loading.is-visible {
  display: flex;
}
#vxnav-{{ section.id }} .vxnav-cp-spinner {
  width: 28px; height: 28px;
  border: 2.5px solid rgba(249,115,22,0.18);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: vxcp-spin 0.75s linear infinite;
}
@keyframes vxcp-spin {
  to { transform: rotate(360deg); }
}

/* ─── Scroll effect via JS class ─────────────────────────────── */

/* ─── Mobile adjustments ─────────────────────────────────────── */
@media (max-width: 480px) {
  #vxnav-{{ section.id }} .vxnav-bar { padding: 0 16px; }
  #vxnav-{{ section.id }} .vxnav-drawer { width: 290px; }
  #vxnav-{{ section.id }} .vxnav-logo-text { font-size: 1.3rem; }
}
</style>

{%- comment -%} ── Sticky bar ── {%- endcomment -%}
<header id="vxnav-{{ section.id }}" role="banner">

