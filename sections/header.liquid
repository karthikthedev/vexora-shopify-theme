<script>
(function () {
  var sid        = '{{ section.id }}';
  var burger     = document.getElementById('vxnav-burger-' + sid);
  var drawer     = document.getElementById('vxnav-drawer-' + sid);
  var backdrop   = document.getElementById('vxnav-backdrop-' + sid);
  var bar        = document.getElementById('vxnav-bar-' + sid);
  var colBtn     = document.getElementById('vxnav-collections-btn-' + sid);
  var colSub     = document.getElementById('vxnav-sub-' + sid);
  var cartCount  = document.getElementById('vxnav-cart-count-' + sid);
  var closeBtn   = document.getElementById('vxnav-close-' + sid);
  var cartBtn    = document.getElementById('vxnav-cart-btn-' + sid);
  var cartPanel  = document.getElementById('vxnav-cart-panel-' + sid);
  var cpClose    = document.getElementById('vxnav-cp-close-' + sid);
  var cpItems    = document.getElementById('vxnav-cp-items-' + sid);
  var cpTotal    = document.getElementById('vxnav-cp-total-' + sid);
  var cpFoot     = document.getElementById('vxnav-cp-foot-' + sid);
  var cpPill     = document.getElementById('vxnav-cp-pill-' + sid);

  /* ── Nav Drawer helpers ── */
  function openDrawer() {
    closeCartPanel();
    burger.classList.add('is-open');
    drawer.classList.add('is-open');
    backdrop.classList.add('is-open');
    burger.setAttribute('aria-expanded', 'true');
    drawer.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }
  function closeDrawer() {
    burger.classList.remove('is-open');
    drawer.classList.remove('is-open');
    backdrop.classList.remove('is-open');
    burger.setAttribute('aria-expanded', 'false');
    drawer.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }
  function toggleDrawer() {
    drawer.classList.contains('is-open') ? closeDrawer() : openDrawer();
  }

  /* ── Cart Panel helpers ── */
  function openCartPanel() {
    closeDrawer();
    cartPanel.classList.add('is-open');
    backdrop.classList.add('is-open');
    cartBtn.setAttribute('aria-expanded', 'true');
    cartPanel.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    refreshCart();
    document.dispatchEvent(new CustomEvent('cart:opened'));
  }
  function closeCartPanel() {
    if (!cartPanel) return;
    cartPanel.classList.remove('is-open');
    backdrop.classList.remove('is-open');
    if (cartBtn) cartBtn.setAttribute('aria-expanded', 'false');
    cartPanel.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    document.dispatchEvent(new CustomEvent('cart:closed'));
  }
  function toggleCartPanel() {
    cartPanel.classList.contains('is-open') ? closeCartPanel() : openCartPanel();
  }

  /* ── Format money (Shopify stores prices in cents) ── */
  function formatMoney(cents) {
    var symbol = window.Shopify && window.Shopify.currency && window.Shopify.currency.symbol
      ? window.Shopify.currency.symbol
      : '$';
    return symbol + (cents / 100).toFixed(2);
  }

  /* ── Render cart items into panel ── */
  function renderCart(cart) {
    if (!cpItems) return;

    /* Update count badge */
    var count = cart.item_count || 0;
    if (cartCount) {
      cartCount.textContent = count;
      cartCount.setAttribute('data-count', count);
      cartCount.style.transform = 'scale(1.4)';
      setTimeout(function() { cartCount.style.transform = ''; }, 250);
    }
    if (cpPill) {
      cpPill.textContent = count + (count === 1 ? ' item' : ' items');
    }

    /* Update total + show/hide footer */
    if (cpTotal) cpTotal.textContent = formatMoney(cart.total_price);
    if (cpFoot)  cpFoot.style.display = count > 0 ? '' : 'none';

    /* Build items HTML */
    if (count === 0) {
      cpItems.innerHTML =
        '<div class="vxnav-cp-empty">' +
          '<div class="vxnav-cp-empty-icon">' +
            '<svg width="28" height="28" viewBox="0 0 28 28" fill="none">' +
              '<path d="M3 3h2l3 13a3 3 0 0 0 2.94 2h9.12a3 3 0 0 0 2.91-2.3L25 8H7" stroke="#F97316" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>' +
              '<circle cx="11" cy="24" r="1.6" fill="#F97316"/>' +
              '<circle cx="19" cy="24" r="1.6" fill="#F97316"/>' +
            '</svg>' +
          '</div>' +
          '<h4>Your cart is empty</h4>' +
          '<p>Looks like you haven\'t added anything yet. Explore our collections to find what your body needs.</p>' +
          '<a href="/collections/fitness">Shop now <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>' +
        '</div>';
      return;
    }

    var html = '';
    cart.items.forEach(function(item) {
      var imgHtml = item.image
        ? '<img src="' + item.image + '" alt="' + (item.title || '').replace(/"/g,'&quot;') + '" loading="lazy" width="64" height="64">'
        : '';
      var variantHtml = (item.variant_title && item.variant_title !== 'Default Title')
        ? '<p class="vxnav-cp-item-variant">' + item.variant_title + '</p>'
        : '';
      html +=
        '<div class="vxnav-cp-item" data-key="' + item.key + '">' +
          '<div class="vxnav-cp-img">' + imgHtml + '</div>' +
          '<div class="vxnav-cp-info">' +
            '<p class="vxnav-cp-item-title">' + item.product_title + '</p>' +
            variantHtml +
            '<div class="vxnav-cp-item-row">' +
              '<span class="vxnav-cp-item-price">' + formatMoney(item.line_price) + '</span>' +
              '<div class="vxnav-cp-qty">' +
                '<button class="vxnav-cp-qty-btn" data-action="decrease" data-key="' + item.key + '" data-qty="' + item.quantity + '" aria-label="Decrease">−</button>' +
                '<span class="vxnav-cp-qty-val">' + item.quantity + '</span>' +
                '<button class="vxnav-cp-qty-btn" data-action="increase" data-key="' + item.key + '" data-qty="' + item.quantity + '" aria-label="Increase">+</button>' +
              '</div>' +
            '</div>' +
          '</div>' +
          '<button class="vxnav-cp-remove" data-key="' + item.key + '" aria-label="Remove from cart">' +
            '<svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 2l8 8M10 2L2 10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>' +
          '</button>' +
        '</div>';
    });
    cpItems.innerHTML = html;

    /* Re-bind qty + remove buttons after re-render */
    bindCartItemEvents();
  }

  /* ── Fetch fresh cart data and re-render ── */
  function refreshCart() {
    fetch('/cart.js', { headers: { 'Content-Type': 'application/json' } })
      .then(function(r) { return r.json(); })
      .then(function(data) { renderCart(data); })
      .catch(function() {});
  }

  /* ── Update item quantity via Cart API ── */
  function updateQty(key, newQty) {
    fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: key, quantity: newQty })
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      renderCart(data);
      document.dispatchEvent(new CustomEvent('cart:updated'));
    })
    .catch(function() {});
  }

  /* ── Bind qty & remove buttons ── */
  function bindCartItemEvents() {
    if (!cpItems) return;

    /* Qty buttons */
    cpItems.querySelectorAll('.vxnav-cp-qty-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var key    = btn.getAttribute('data-key');
        var qty    = parseInt(btn.getAttribute('data-qty'), 10);
        var action = btn.getAttribute('data-action');
        var newQty = action === 'increase' ? qty + 1 : Math.max(0, qty - 1);
        updateQty(key, newQty);
      });
    });

    /* Remove buttons */
    cpItems.querySelectorAll('.vxnav-cp-remove').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var key = btn.getAttribute('data-key');
        updateQty(key, 0);
      });
    });
  }

  /* ── Event bindings ── */
  if (burger) {
    burger.addEventListener('click', function(e) {
      e.stopPropagation();
      toggleDrawer();
    });
  }

  if (cartBtn) {
    cartBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      toggleCartPanel();
    });
  }

  if (cpClose) cpClose.addEventListener('click', closeCartPanel);

  backdrop.addEventListener('click', function() {
    closeDrawer();
    closeCartPanel();
  });

  if (closeBtn) closeBtn.addEventListener('click', closeDrawer);

  /* Click outside to close both */
  document.addEventListener('click', function(e) {
    if (drawer && drawer.classList.contains('is-open') &&
        !drawer.contains(e.target) && !burger.contains(e.target)) {
      closeDrawer();
    }
    if (cartPanel && cartPanel.classList.contains('is-open') &&
        !cartPanel.contains(e.target) && cartBtn && !cartBtn.contains(e.target)) {
      closeCartPanel();
    }
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') { closeDrawer(); closeCartPanel(); }
  });

  /* Collections sub-menu */
  if (colBtn && colSub) {
    colBtn.addEventListener('click', function() {
      var isOpen = colSub.classList.contains('is-open');
      colSub.classList.toggle('is-open', !isOpen);
      colBtn.classList.toggle('is-active', !isOpen);
      colBtn.setAttribute('aria-expanded', String(!isOpen));
      colSub.setAttribute('aria-hidden', String(isOpen));
    });
  }

  /* Scroll shadow on bar */
  window.addEventListener('scroll', function() {
    if (bar) bar.classList.toggle('is-scrolled', window.scrollY > 10);
  }, { passive: true });

  /* Close nav links */
  if (drawer) {
    drawer.querySelectorAll('a').forEach(function(link) {
      link.addEventListener('click', closeDrawer);
    });
  }

  /* Initial cart count sync */
  refreshCart();

  /* Listen for external cart updates */
  document.addEventListener('cart:updated', refreshCart);
  document.addEventListener('theme:cart:added', function() {
    refreshCart();
    openCartPanel();
  });

  /* Bind initial server-rendered items */
  bindCartItemEvents();

})();
</script>

